# ======================================================================
# ManUp Platform — Environment Variables
# Copy to .env.local (local dev) and set the same keys in Vercel.
# NEVER commit real secrets. NEVER prefix server secrets with NEXT_PUBLIC_.
# ======================================================================

# ---------------- PUBLIC (browser-visible) Firebase web config -------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: Firebase App Check reCAPTCHA v3 site key (recommended in prod)
NEXT_PUBLIC_FIREBASE_APPCHECK_KEY=

# ---------------- App -----------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ManUp

# ---------------- SERVER-ONLY Firebase Admin SDK ---------------------
# Used ONLY in server code (API routes / server components / scripts).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Private key with \n escaped newlines, wrapped in quotes:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional: base64-encoded full service-account JSON (alternative to above 3)
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# ---------------- Master administrator (full access) -----------------
# These two values create the always-available super-admin account.
# Sign in at /login with them and you land in the owner console with full
# access (content, users, roles, settings, maintenance) — no Firebase needed.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
# Optional display name and extra full-access addresses (comma-separated)
ADMIN_NAME=Master Admin
# ADMIN_EMAILS=second@example.com,third@example.com

# ---------------- Data backend ---------------------------------------
# auto (default): Firebase when credentials exist, otherwise the embedded
# SQLite store. Force with: DATA_BACKEND=firebase | local
DATA_BACKEND=auto
# Where the embedded database + uploaded media live (default ./data)
DATA_DIR=./data
# Secret used to sign session tokens (auto-generated & stored if omitted)
SESSION_SECRET=
# Allow visitors to create their own accounts (default true)
ALLOW_REGISTRATION=true
# Disable the Next.js image optimizer when the host blocks egress (default false)
NEXT_PUBLIC_UNOPTIMIZED_IMAGES=false

# ---------------- Owner bootstrap ------------------------------------
# Email(s) allowed to claim the FIRST owner account via the setup flow.
# Comma-separated. Checked server-side only.
OWNER_EMAILS=owner@example.com
# One-time bootstrap token required to run /api/setup/* endpoints.
SETUP_TOKEN=change-me-to-a-long-random-token

# ---------------- SMTP (server-only) ---------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=ManUp
SMTP_REPLY_TO=

# ---------------- Sessions & security --------------------------------
# Session cookie name + lifetime (default 5 days max for Firebase cookies)
SESSION_COOKIE_NAME=__session
SESSION_MAX_AGE_DAYS=5
# Optional override: force maintenance mode even if Firestore unreachable
# MAINTENANCE_MODE=false
# Optional: comma-separated extra allowed origins for API CORS checks
# ALLOWED_ORIGINS=https://example.com

# ---------------- Vercel (auto-provided, informational) --------------
# VERCEL_ENV, VERCEL_URL, VERCEL_GIT_COMMIT_SHA are set by Vercel.

# Allow the app to be embedded in a preview iframe (sandbox/preview hosts).
# Leave unset/false in production to keep clickjacking protection on.
ALLOW_EMBEDDING=false
